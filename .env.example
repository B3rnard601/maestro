# Telegram
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (message @userinfobot to get it). This is now
# a HARD REQUIREMENT, not optional: it's the only way anyone becomes admin,
# and every new user starts in a 'pending' state that only an admin can
# approve (/admin_approve or the one-tap button on the DM you get for each
# new signup). Leave this unset and no one — including you — can ever be
# approved; the bot would respond to /start and /help only, forever.
TELEGRAM_OWNER_ID=

# Solana
# Optional RPC overrides. Provider API keys are not required: leave either
# value blank to use the public endpoint. Public RPCs are rate-limited and not
# recommended for reliable low-latency trading.
# For faster event subscriptions, use a Geyser-backed provider such as
# Helius or Triton; public endpoints can delay or miss sniping/copy-trade events.
SOLANA_RPC_HTTP=
SOLANA_RPC_WSS=
# Optional; defaults to the public Jito block engine.
SOLANA_JITO_BLOCK_ENGINE=https://mainnet.block-engine.jito.wtf

# EVM
EVM_RPC_HTTP=https://eth.llamarpc.com
EVM_RPC_WSS=wss://eth.llamarpc.com
EVM_FLASHBOTS_RPC=https://rpc.flashbots.net
UNISWAP_V2_FACTORY=0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f

# Vault
VAULT_MASTER_KEY=

# Risk policy
# Admin hard maximum spend per buy and per UTC day, across manual and
# automated buys. Users can configure lower personal limits in Telegram.
# These are live-mainnet controls, not a recommendation.
MAX_TRADE_SOL=0.1
MAX_TRADE_ETH=0.05
# Per-user daily buy spend hard limits.
MAX_DAILY_SPEND_SOL=1
MAX_DAILY_SPEND_ETH=0.5
# Admin hard maximum slippage; user settings can lower it (1–500 bps).
MAX_SLIPPAGE_BPS=500
# Manual trade previews expire after this many seconds (10–300).
TRADE_QUOTE_TTL_SECONDS=60
