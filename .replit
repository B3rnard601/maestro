modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Admin web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Admin API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram bot"

[[workflows.workflow]]
name = "Admin web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm --prefix admin-web run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Admin API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd admin-server && npm start"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Telegram bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 4000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
EVM_FLASHBOTS_RPC = "https://rpc.flashbots.net"
SOLANA_JITO_BLOCK_ENGINE = "https://mainnet.block-engine.jito.wtf"
UNISWAP_V2_FACTORY = "0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f"
